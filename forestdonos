local autoHopEnabled = false
local autoHopGeneration = 0
local autoHopStateEnv = type(getfenv) == "function" and getfenv() or _G
local savedAutoHopState = rawget(autoHopStateEnv, "__ForestDonationsAutoHop")
if type(savedAutoHopState) == "table" and savedAutoHopState.Enabled == true then
    local savedMin = tonumber(savedAutoHopState.MinPlayers)
    local savedMax = tonumber(savedAutoHopState.MaxPlayers)
    local savedInterval = tonumber(savedAutoHopState.IntervalMinutes)
    if savedMin and savedMax and savedInterval then
        minPlayersBox.Text = tostring(savedMin)
        maxPlayersBox.Text = tostring(savedMax)
        autoIntervalBox.Text = tostring(savedInterval)
        autoHopEnabled = true
        autoHopButton.Text = "Auto Hop: ON"
        autoHopButton.BackgroundColor3 = Color3.fromRGB(72, 120, 82)
    end
end

local function setAutoHopState(enabled, minPlayers, maxPlayers, intervalMinutes)
    local env = type(getfenv) == "function" and getfenv() or _G
    local state = rawget(env, "__ForestDonationsAutoHop")
    if type(state) ~= "table" then
        state = {}
        rawset(env, "__ForestDonationsAutoHop", state)
    end
    state.Enabled = enabled
    state.MinPlayers = minPlayers
    state.MaxPlayers = maxPlayers
    state.IntervalMinutes = intervalMinutes
end

queueAutoHopUiReload = function(enabled, minPlayers, maxPlayers, intervalMinutes)
    local queueCode = buildAutoHopQueueCode(enabled, minPlayers, maxPlayers, intervalMinutes)
    local queueFunctions = getQueueOnTeleport()
    local queueErrors = {}

    for _, queue in ipairs(queueFunctions) do
        local ok, result = pcall(queue, queueCode)
        if ok and result ~= false then
            return true
        end
        table.insert(queueErrors, tostring(result))
    end

    local env = type(getfenv) == "function" and getfenv() or _G
    local writeFile = rawget(env, "writefile")
    local synApi = rawget(env, "syn")
    writeFile = writeFile or (synApi and synApi.write_file)
    if type(writeFile) == "function" then
        local fileOk, fileError = pcall(writeFile, "forestdonos_queued.lua", queueCode)
        if fileOk then
            local fallbackCode = "dofile('forestdonos_queued.lua')"
            for _, queue in ipairs(queueFunctions) do
                local queueOk, result = pcall(queue, fallbackCode)
                if queueOk and result ~= false then
                    return true
                end
                table.insert(queueErrors, tostring(result))
            end
        else
            table.insert(queueErrors, "writefile failed: " .. tostring(fileError))
        end
    end

    if #queueFunctions == 0 then
        return false, "queue_on_teleport is not available."
    end
    return false, "Could not queue the UI reload: " .. table.concat(queueErrors, "; ")
end

local function startAutoHopWorker(minPlayers, maxPlayers, intervalMinutes)
    autoHopEnabled = true
    autoHopGeneration = autoHopGeneration + 1
    local generation = autoHopGeneration
    local intervalSeconds = intervalMinutes * 60

    autoHopButton.Text = "Auto Hop: ON"
    autoHopButton.BackgroundColor3 = Color3.fromRGB(72, 120, 82)
    hopStatus.Text = ("Auto hop enabled: every %d min, targeting %d-%d players.")
        :format(intervalMinutes, minPlayers, maxPlayers)

    task.spawn(function()
        while autoHopEnabled and generation == autoHopGeneration do
            for remaining = intervalSeconds, 1, -1 do
                if not autoHopEnabled or generation ~= autoHopGeneration then
                    return
                end
                if remaining % 60 == 0 then
                    hopStatus.Text = ("Auto hop in %d min; target %d-%d players.")
                        :format(remaining / 60, minPlayers, maxPlayers)
                end
                task.wait(1)
            end
            if autoHopEnabled and generation == autoHopGeneration then
                while hopping and autoHopEnabled and generation == autoHopGeneration do
                    task.wait(0.2)
                end
                if not autoHopEnabled or generation ~= autoHopGeneration then
                    return
                end
                hopping = true
                hopStatus.Text = "Auto-hop timer elapsed; searching for a matching server..."
                local ok, joined, message = pcall(serverHop, minPlayers, maxPlayers)
                if not ok then
                    local hopError = joined
                    joined = false
                    message = "Unexpected auto-hop error: " .. tostring(hopError)
                end
                hopStatus.Text = tostring(message)
                notify(message)
                if not joined then
                    warn("[Forest Donations] " .. tostring(message))
                    hopping = false
                else
                    print("[Forest Donations] " .. tostring(message))
                    return
                end
            end
        end
    end)
end

autoHopButton.MouseButton1Click:Connect(function()
    if autoHopEnabled then
        autoHopEnabled = false
        autoHopGeneration = autoHopGeneration + 1
        local minPlayers = tonumber(minPlayersBox.Text) or 0
        local maxPlayers = tonumber(maxPlayersBox.Text) or minPlayers
        local intervalMinutes = tonumber(autoIntervalBox.Text) or 30
        setAutoHopState(false, minPlayers, maxPlayers, intervalMinutes)
        local queued, queueError = queueAutoHopUiReload(false, minPlayers, maxPlayers, intervalMinutes)
        autoHopButton.Text = "Auto Hop: OFF"
        autoHopButton.BackgroundColor3 = Color3.fromRGB(68, 69, 74)
        hopStatus.Text = queued
            and "Auto hop disabled; the UI will reload after your next teleport."
            or ("Auto hop disabled locally. " .. tostring(queueError))
        return
    end

    local minPlayers = tonumber(minPlayersBox.Text)
    local maxPlayers = tonumber(maxPlayersBox.Text)
    local intervalMinutes = tonumber(autoIntervalBox.Text)
    if not minPlayers or not maxPlayers
        or minPlayers < 0 or maxPlayers < minPlayers
        or minPlayers % 1 ~= 0 or maxPlayers % 1 ~= 0 then
        hopStatus.Text = "Set a valid minimum and maximum player range first."
        return
    end
    if not intervalMinutes or intervalMinutes < 1
        or intervalMinutes > 1440 or intervalMinutes % 1 ~= 0 then
        hopStatus.Text = "Auto-hop interval must be a whole number from 1 to 1440 minutes."
        return
    end

    local queued, queueError = queueAutoHopUiReload(true, minPlayers, maxPlayers, intervalMinutes)
    if not queued then
        hopStatus.Text = "Auto-hop across servers needs queue_on_teleport support. " .. tostring(queueError)
        notify(hopStatus.Text)
        return
    end

    setAutoHopState(true, minPlayers, maxPlayers, intervalMinutes)
    startAutoHopWorker(minPlayers, maxPlayers, intervalMinutes)
end)

if autoHopEnabled then
    local minPlayers = tonumber(minPlayersBox.Text)
    local maxPlayers = tonumber(maxPlayersBox.Text)
    local intervalMinutes = tonumber(autoIntervalBox.Text)
    local queued, queueError = queueAutoHopUiReload(true, minPlayers, maxPlayers, intervalMinutes)
    if queued then
        startAutoHopWorker(minPlayers, maxPlayers, intervalMinutes)
    else
        autoHopEnabled = false
        setAutoHopState(false, minPlayers, maxPlayers, intervalMinutes)
        autoHopButton.Text = "Auto Hop: OFF"
        autoHopButton.BackgroundColor3 = Color3.fromRGB(68, 69, 74)
        hopStatus.Text = "Auto-hop could not resume: " .. tostring(queueError)
        notify(hopStatus.Text)
    end
end

task.spawn(function()
    local folder = getStandFolder()
    if not folder then
        status.Text = "Workspace.DonationStands was not found."
        warn("[Forest Donations] Workspace.DonationStands was not found.")
        return
    end

    local stand, slot = chooseStand(folder)
    if not stand then
        status.Text = "No DonationStand_01 through DonationStand_27 models were found."
        warn("[Forest Donations] No valid donation stand models were found.")
        return
    end

    standBox.Text = tostring(slot)
    status.Text = ("Found DonationStand_%02d. Claiming and moving there..."):format(slot)
    runClaim(slot, true)
end)
