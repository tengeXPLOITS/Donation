        return false, "Enter a valid Discord webhook URL of 512 characters or fewer."
    end
    if enabled and not isValidDiscordWebhookUrl(url) then
        return false, "Enter a valid Discord webhook URL."
    end
    return saveAutoHopState({
        Enabled = previous and previous.Enabled == true or false,
        MinPlayers = previous and previous.MinPlayers or 0,
        MaxPlayers = previous and previous.MaxPlayers or 27,
        IntervalMinutes = previous and previous.IntervalMinutes or 30,
        PopulationEnabled = previous and previous.PopulationEnabled == true or false,
        PopulationThreshold = previous and previous.PopulationThreshold or 10,
        WebhookEnabled = enabled == true,
        WebhookUrl = url,
    })
end

