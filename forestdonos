local function getHttpRequest()
    local synApi = rawget(getfenv(), "syn")
    if synApi and synApi.request then return synApi.request end
    local httpApi = rawget(getfenv(), "http")
    if httpApi and httpApi.request then return httpApi.request end
    local env = getfenv()
    if env.http_request then return env.http_request end
    if env.request then return env.request end
    return nil
end

local function requestServerPage(url)
    local httpRequest = getHttpRequest()
    if httpRequest then
        for attempt = 1, 4 do
            local ok, response = pcall(httpRequest, {
                Url = url,
                Method = "GET",
                Headers = {["User-Agent"] = "Roblox"},
            })
            if not ok then
                return nil, "The HTTP request failed: " .. tostring(response)
            end
            if not response then
                return nil, "The HTTP request returned no response."
            end

            local statusCode = tonumber(response.StatusCode or response.Status)
            if statusCode == 429 then
                if attempt == 4 then
                    return nil, "Server list request remained rate-limited (HTTP 429) after 4 attempts."
                end
                local headers = response.Headers or response.headers
                local retryAfter
                if type(headers) == "table" then
                    for name, value in pairs(headers) do
                        if string.lower(tostring(name)) == "retry-after" then
                            retryAfter = tonumber(value)
                            break
                        end
                    end
                end
                task.wait(math.min(math.max(retryAfter or (2 ^ (attempt - 1)), 1), 30))
            elseif statusCode and (statusCode < 200 or statusCode >= 300) then
                return nil, ("Server list request failed with HTTP %d."):format(statusCode)
            else
                return response.Body or response.body or response.responseBody or response.text
            end
        end
        return nil, "Server list request failed after retries."
    end

    local getAsyncError
    for attempt = 1, 4 do
        local ok, body = pcall(function()
            return HttpService:GetAsync(url)
        end)
        if ok then
            return body
        end
        getAsyncError = body
        if not string.find(tostring(body), "429", 1, true) then
            break
        end
        if attempt < 4 then
            task.wait(2 ^ (attempt - 1))
        end
    end

    if string.find(tostring(getAsyncError), "429", 1, true) then
        return nil, "Server list request remained rate-limited (HTTP 429) after 4 attempts."
    end

    local httpGetOk, httpGetBody = pcall(function()
        return game:HttpGet(url)
    end)
    if httpGetOk then
        return httpGetBody
    end
    return nil, "Could not request the public server list: "
        .. tostring(getAsyncError) .. "; fallback failed: " .. tostring(httpGetBody)
end

local queueAutoHopUiReload

local function serverHop(minPlayers, maxPlayers)
    local cursor = nil
    local candidates = {}

    for _ = 1, 10 do
        if cursor then
            task.wait(0.4)
        end
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100")
            :format(SERVER_HOP_PLACE_ID)
        if cursor then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local body, requestError = requestServerPage(url)
        if not body then
            return false, requestError or "The public server list was empty."
        end
        local decodedOk, page = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if not decodedOk or type(page) ~= "table" or type(page.data) ~= "table" then
            return false, "Could not parse the public server list response."
        end

        for _, server in ipairs(page.data) do
            local playing = tonumber(server.playing)
            if playing
                and playing >= minPlayers
                and playing <= maxPlayers
                and server.id
                and tostring(server.id) ~= tostring(game.JobId) then
                table.insert(candidates, server)
            end
        end

        cursor = page.nextPageCursor
        if not cursor or #candidates > 0 then
            break
        end
        task.wait(0.2)
    end

    if #candidates == 0 then
        return false, ("No other servers found with %d-%d players."):format(minPlayers, maxPlayers)
    end

    local target = candidates[math.random(1, #candidates)]
    local env = type(getfenv) == "function" and getfenv() or _G
    local savedState = rawget(env, "__ForestDonationsAutoHop")
    local autoHopActive = type(savedState) == "table" and savedState.Enabled == true
    local persistMin = autoHopActive and tonumber(savedState.MinPlayers) or minPlayers
    local persistMax = autoHopActive and tonumber(savedState.MaxPlayers) or maxPlayers
    local persistInterval = autoHopActive and tonumber(savedState.IntervalMinutes) or 30
    local queued, queueError = queueAutoHopUiReload(
        autoHopActive,
        persistMin,
        persistMax,
        persistInterval
    )
    if not queued then
        return false, "Could not prepare the UI reload before teleport: " .. tostring(queueError)
    end

    local ok, teleportError = pcall(function()
        TeleportService:TeleportToPlaceInstance(SERVER_HOP_PLACE_ID, target.id, LocalPlayer)
    end)
    if not ok then
        return false, "Teleport failed: " .. tostring(teleportError)
    end
    return true, ("Joining a server with %d players..."):format(tonumber(target.playing) or 0)
end

local function getQueueOnTeleport()
    local env = type(getfenv) == "function" and getfenv() or _G
    local queueFunctions = {}
    local function addQueue(candidate)
        if type(candidate) == "function" then
            for _, existing in ipairs(queueFunctions) do
                if existing == candidate then return end
            end
            table.insert(queueFunctions, candidate)
        end
    end

    addQueue(rawget(env, "queue_on_teleport"))
    local synApi = rawget(env, "syn")
    addQueue(synApi and synApi.queue_on_teleport)
    local fluxusApi = rawget(env, "fluxus")
    addQueue(fluxusApi and fluxusApi.queue_on_teleport)
    addQueue(rawget(_G, "queue_on_teleport"))
    return queueFunctions
end

