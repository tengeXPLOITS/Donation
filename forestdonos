repeat
    task.wait()
until game:IsLoaded()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local COMMUNITY_ID = 35401545
local LocalPlayer = Players.LocalPlayer

if game.CreatorType ~= Enum.CreatorType.Group or game.CreatorId ~= COMMUNITY_ID then
    warn("[Forest Donations] This script is restricted to games owned by community " .. tostring(COMMUNITY_ID) .. ".")
    return
end

if not LocalPlayer then
    warn("[Forest Donations] LocalPlayer is unavailable; stopping.")
    return
end

local function notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Forest Donations",
            Text = tostring(text),
            Duration = 5,
        })
    end)
end

local function getStandFolder()
    return Workspace:FindFirstChild("DonationStands") or Workspace:WaitForChild("DonationStands", 10)
end

local function getStandModel(folder, slot)
    if not folder or slot < 1 or slot > 27 then
        return nil
    end
    local name = ("DonationStand_%02d"):format(slot)
    local stand = folder:FindFirstChild(name)
    if stand and stand:IsA("Model") then
        return stand
    end
    return nil
end

local function getStandOwnership(stand)
    local localName = string.lower(tostring(LocalPlayer.Name))
    local localDisplayName = string.lower(tostring(LocalPlayer.DisplayName))
    local localUserId = tostring(LocalPlayer.UserId)

    local function interpret(name, value)
        local key = string.lower(tostring(name))
        if key == "claimed" or key == "isclaimed" then
            if type(value) == "boolean" then
                return value and "claimed" or "available"
            end
        elseif key == "owneruserid" then
            local ownerId = tostring(value or "")
            if ownerId == "" or ownerId == "0" then return "available" end
            if ownerId == localUserId then return "owned" end
            return "claimed"
        elseif key == "owner" or key == "occupant" then
            if typeof(value) == "Instance" then
                value = value.Name
            end
            local ownerName = string.lower(tostring(value or ""))
            if ownerName == "" or ownerName == "unclaimed" or ownerName == "none" or ownerName == "nil" then
                return "available"
            end
            if ownerName == localName or ownerName == localDisplayName or ownerName == localUserId then
                return "owned"
            end
            return "claimed"
        end
        return nil
    end

    for attributeName, attributeValue in pairs(stand:GetAttributes()) do
        local state = interpret(attributeName, attributeValue)
        if state then return state end
    end

    for _, descendant in ipairs(stand:GetDescendants()) do
        if descendant:IsA("ValueBase") then
            local state = interpret(descendant.Name, descendant.Value)
            if state then return state end
        end
    end

    return "unknown"
end

local function chooseStand(folder)
    local unknownStand = nil
    for slot = 1, 27 do
        local stand = getStandModel(folder, slot)
        if stand then
            local ownership = getStandOwnership(stand)
            if ownership == "owned" then
                return stand, slot, true
            elseif ownership == "available" then
                return stand, slot, false
            elseif ownership == "unknown" and not unknownStand then
                unknownStand = {stand, slot}
            end
        end
    end

    if unknownStand then
        return unknownStand[1], unknownStand[2], false
    end
    return nil
end

local function getClaimRemote()
    local remotes = ReplicatedStorage:FindFirstChild("DonationBoothRemotes")
        or ReplicatedStorage:WaitForChild("DonationBoothRemotes", 10)
    if not remotes then return nil end
    local remote = remotes:FindFirstChild("ClaimStand") or remotes:WaitForChild("ClaimStand", 5)
    if remote and remote:IsA("RemoteEvent") then
        return remote
    end
    return nil
end

local function teleportToStand(stand)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
    if not root then
        return false, "Your character's HumanoidRootPart was not found."
    end

    local ok, boundingCFrame, boundingSize = pcall(function()
        return stand:GetBoundingBox()
    end)
    if not ok then
        return false, "Could not determine the stand's position: " .. tostring(boundingCFrame)
    end

    local forward = boundingCFrame.LookVector
    local targetPosition = boundingCFrame.Position
        + forward * (math.max(boundingSize.X, boundingSize.Z) * 0.5 + 4)
        + Vector3.new(0, 2, 0)
    root.CFrame = CFrame.lookAt(targetPosition, boundingCFrame.Position)
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    return true
end

local function claimAndGoToStand(slot)
    slot = tonumber(slot)
    if not slot or slot % 1 ~= 0 or slot < 1 or slot > 27 then
        return false, "Choose a stand number from 1 to 27."
    end

    local folder = getStandFolder()
    if not folder then
        return false, "Workspace.DonationStands was not found."
    end
    local stand = getStandModel(folder, slot)
    if not stand then
        return false, ("DonationStand_%02d was not found."):format(slot)
    end

    local ownership = getStandOwnership(stand)
    if ownership == "claimed" then
        return false, ("DonationStand_%02d appears to belong to another player."):format(slot)
    end

    if ownership ~= "owned" then
        local remote = getClaimRemote()
        if not remote then
            return false, "ReplicatedStorage.DonationBoothRemotes.ClaimStand RemoteEvent was not found."
        end

        local fired, fireError = pcall(function()
            remote:FireServer(slot)
        end)
        if not fired then
            return false, "Claim request failed: " .. tostring(fireError)
        end
        task.wait(0.35)
    end

    local moved, moveError = teleportToStand(stand)
    if not moved then
        return false, moveError
    end

    local afterClaim = getStandOwnership(stand)
    if ownership == "owned" or afterClaim == "owned" then
        return true, ("Moved to your stand (%02d)."):format(slot)
    elseif afterClaim == "available" then
        return true, ("Claim requested and moved to stand %02d; ownership is not confirmed yet."):format(slot)
    elseif afterClaim == "claimed" then
        return true, ("Claim request sent and moved to stand %02d."):format(slot)
    end
    return true, ("Claim request sent and moved to stand %02d; this stand does not expose ownership status."):format(slot)
end

