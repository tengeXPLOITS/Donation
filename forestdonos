local function notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Forest Donations",
            Text = tostring(text),
            Duration = 5,
        })
    end)
end

local function getStandFolder()
    return Workspace:FindFirstChild("DonationStands") or Workspace:WaitForChild("DonationStands", 10)
end

local function getStandModel(folder, slot)
    if not folder or slot < 1 or slot > 27 then
        return nil
    end
    local name = ("DonationStand_%02d"):format(slot)
    local stand = folder:FindFirstChild(name)
    if stand and stand:IsA("Model") then
        return stand
    end
    return nil
end

local function getStandOwnership(stand)
    local localName = string.lower(tostring(LocalPlayer.Name))
    local localDisplayName = string.lower(tostring(LocalPlayer.DisplayName))
    local localUserId = tostring(LocalPlayer.UserId)

    local function findOwnershipValue(fieldName)
        for attributeName, value in pairs(stand:GetAttributes()) do
            if string.lower(tostring(attributeName)) == fieldName then
                return value, true
            end
        end

        for _, descendant in ipairs(stand:GetDescendants()) do
            if descendant:IsA("ValueBase") and string.lower(descendant.Name) == fieldName then
                return descendant.Value, true
            end
        end
        return nil, false
    end

    local ownerUserId, hasOwnerUserId = findOwnershipValue("owneruserid")
    if hasOwnerUserId then
        local id = tostring(ownerUserId or "")
        if id == "" or id == "0" then return "available" end
        if id == localUserId then return "owned" end
        return "claimed"
    end

    local ownerName, hasOwnerName = findOwnershipValue("ownername")
    if hasOwnerName then
        if typeof(ownerName) == "Instance" then
            ownerName = ownerName.Name
        end
        local name = string.lower(tostring(ownerName or ""))
        if name == "" or name == "unclaimed" or name == "none" or name == "nil" then
            return "available"
        end
        if name == localName or name == localDisplayName or name == localUserId then
            return "owned"
        end
        return "claimed"
    end

    local claimed, hasClaimed = findOwnershipValue("claimed")
    if not hasClaimed then
        claimed, hasClaimed = findOwnershipValue("isclaimed")
    end
    if hasClaimed and type(claimed) == "boolean" then
        return claimed and "claimed" or "available"
    end

    return "unknown"
end

local function chooseStand(folder)
    local unknownStand = nil
    local ownedStand = nil
    for slot = 1, 27 do
        local stand = getStandModel(folder, slot)
        if stand then
            local ownership = getStandOwnership(stand)
            if ownership == "owned" then
                if not ownedStand then
                    ownedStand = {stand, slot}
                end
            elseif ownership == "available" then
                return stand, slot, false
            elseif ownership == "unknown" and not unknownStand then
                unknownStand = {stand, slot}
            end
        end
    end

    if unknownStand then
        return unknownStand[1], unknownStand[2], false
    end
    if ownedStand then
        return ownedStand[1], ownedStand[2], true
    end
    return nil
end

local function getClaimPrompt(stand)
    local boothKit = stand:FindFirstChild("BoothKit")
    local itemsPart = boothKit and boothKit:FindFirstChild("ItemsPart")
    local attachment = itemsPart and itemsPart:FindFirstChild("ClaimAttachment")
    local prompt = attachment and attachment:FindFirstChild("ClaimPrompt")
    if prompt and prompt:IsA("ProximityPrompt") then
        return prompt
    end
    return nil
end

local function teleportToClaimPrompt(prompt)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
    if not root then
        return false, "Your character's HumanoidRootPart was not found."
    end

    local attachment = prompt.Parent
    if not attachment or not attachment:IsA("Attachment") then
        return false, "The claim prompt is not attached to ClaimAttachment."
    end

    local promptCFrame = attachment.WorldCFrame
    local offset = math.min(3, prompt.MaxActivationDistance * 0.5)
    local targetPosition = promptCFrame.Position + promptCFrame.LookVector * offset
    root.CFrame = CFrame.lookAt(targetPosition, promptCFrame.Position)
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    task.wait()

    return true
end

local function activateClaimPrompt(prompt)
    if not prompt.Enabled then
        return false, "The claim prompt is disabled."
    end

    local activated, activationError = pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.08)
        prompt:InputHoldEnd()
    end)
    if not activated then
        pcall(function()
            prompt:InputHoldEnd()
        end)
        return false, "Could not activate the claim prompt: " .. tostring(activationError)
    end
    return true
end

local function teleportToStand(stand)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
    if not root then
        return false, "Your character's HumanoidRootPart was not found."
    end

    local ok, boundingCFrame, boundingSize = pcall(function()
        return stand:GetBoundingBox()
    end)
    if not ok then
        return false, "Could not determine the stand's position: " .. tostring(boundingCFrame)
    end

    local forward = boundingCFrame.LookVector
    local targetPosition = boundingCFrame.Position
        + forward * (math.max(boundingSize.X, boundingSize.Z) * 0.5 + 4)
        + Vector3.new(0, 2, 0)
    local awayDirection = targetPosition - boundingCFrame.Position
    if awayDirection.Magnitude <= 1e-6 then
        awayDirection = forward
    end
    root.CFrame = CFrame.lookAt(targetPosition, targetPosition + awayDirection.Unit)
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    return true
end

local function claimAndGoToStand(slot)
    slot = tonumber(slot)
    if not slot or slot % 1 ~= 0 or slot < 1 or slot > 27 then
        return false, "Choose a stand number from 1 to 27."
    end

    local folder = getStandFolder()
    if not folder then
        return false, "Workspace.DonationStands was not found."
    end
    local stand = getStandModel(folder, slot)
    if not stand then
        return false, ("DonationStand_%02d was not found."):format(slot)
    end

    local ownership = getStandOwnership(stand)
    if ownership == "claimed" then
        return false, ("DonationStand_%02d appears to belong to another player."):format(slot)
    end

    local prompt = getClaimPrompt(stand)
    if not prompt then
        return false, ("DonationStand_%02d is missing BoothKit.ItemsPart.ClaimAttachment.ClaimPrompt."):format(slot)
    end

    if ownership ~= "owned" then
        local movedToPrompt, promptMoveError = teleportToClaimPrompt(prompt)
        if not movedToPrompt then
            return false, promptMoveError
        end

        local activated, activationError = activateClaimPrompt(prompt)
        if not activated then
            return false, ("Could not claim DonationStand_%02d: %s"):format(slot, activationError)
        end

        local deadline = os.clock() + 0.3
        repeat
            task.wait(0.05)
            ownership = getStandOwnership(stand)
        until ownership == "owned" or ownership == "claimed" or os.clock() >= deadline
    end

    local afterClaim = getStandOwnership(stand)
    local moved, moveError = teleportToStand(stand)
    if not moved then
        return false, moveError
    end

    if ownership == "owned" or afterClaim == "owned" then
        return true, ("Moved to your stand (%02d)."):format(slot)
    elseif afterClaim == "available" then
        return true, ("Claim prompt activated and moved to stand %02d; ownership is not confirmed yet."):format(slot)
    elseif afterClaim == "claimed" then
        return true, ("Claim prompt activated and moved to stand %02d."):format(slot)
    end
    return true, ("Claim prompt activated and moved to stand %02d; this stand does not expose ownership status."):format(slot)
end

