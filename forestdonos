local busy = false
local function runClaim(slot)
    if busy then return end
    busy = true
    claimButton.Active = false
    claimButton.Text = "Working..."

    task.spawn(function()
        local ok, success, message = pcall(claimAndGoToStand, slot)
        if not ok then
            local claimError = success
            success = false
            message = "Unexpected claim error: " .. tostring(claimError)
        end
        status.Text = tostring(message)
        if success then
            print("[Forest Donations] " .. tostring(message))
        else
            warn("[Forest Donations] " .. tostring(message))
            notify(message)
        end
        claimButton.Active = true
        claimButton.Text = "Claim & Teleport"
        busy = false
    end)
end

claimButton.MouseButton1Click:Connect(function()
    local slot = tonumber(standBox.Text)
    if not slot then
        status.Text = "Enter a stand number from 1 to 27."
        return
    end
    runClaim(slot)
end)

task.spawn(function()
    local folder = getStandFolder()
    if not folder then
        status.Text = "Workspace.DonationStands was not found."
        warn("[Forest Donations] Workspace.DonationStands was not found.")
        return
    end

    local stand, slot = chooseStand(folder)
    if not stand then
        status.Text = "No DonationStand_01 through DonationStand_27 models were found."
        warn("[Forest Donations] No valid donation stand models were found.")
        return
    end

    standBox.Text = tostring(slot)
    status.Text = ("Found DonationStand_%02d. Claiming and moving there..."):format(slot)
    runClaim(slot)
end)
