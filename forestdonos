local function runClaim(slot, forceClaim)
    if busy or rawget(getExecutorEnv(), claimLockKey) then return end
    busy = true
    rawset(getExecutorEnv(), claimLockKey, true)
    claimButton.Active = false
    claimButton.Text = "Working..."

    task.spawn(function()
        local ok, success, message, actualSlot = pcall(claimAndGoToStand, slot, forceClaim)
        if not ok then
            local claimError = success
            success = false
            message = "Unexpected claim error: " .. tostring(claimError)
        end
        status.Text = tostring(message)
        notify(message)
        if success then
            if actualSlot then
                standBox.Text = tostring(actualSlot)
            end
            print("[Forest Donations] " .. tostring(message))
        else
            warn("[Forest Donations] " .. tostring(message))
        end
        claimButton.Active = true
        claimButton.Text = "Claim & Teleport"
        busy = false
        rawset(getExecutorEnv(), claimLockKey, nil)
    end)
end

