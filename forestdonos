local function getExecutorFunction(name)
    local env = getExecutorEnv()
    local candidate = rawget(env, name) or rawget(_G, name)
    if type(candidate) == "function" then
        return candidate
    end
    local synApi = rawget(env, "syn")
    candidate = synApi and rawget(synApi, name)
    if not candidate and name == "writefile" and type(synApi) == "table" then
        candidate = rawget(synApi, "write_file")
    end
    if type(candidate) == "function" then
        return candidate
    end
    return nil
end

local function isValidAutoHopState(state)
    return type(state) == "table"
        and type(state.Enabled) == "boolean"
        and tonumber(state.MinPlayers) ~= nil
        and tonumber(state.MaxPlayers) ~= nil
        and tonumber(state.IntervalMinutes) ~= nil
        and tonumber(state.MinPlayers) >= 0
        and tonumber(state.MaxPlayers) >= tonumber(state.MinPlayers)
        and tonumber(state.IntervalMinutes) >= 1
        and tonumber(state.IntervalMinutes) <= 1440
        and (state.PopulationEnabled == nil or type(state.PopulationEnabled) == "boolean")
        and (state.PopulationThreshold == nil
            or (tonumber(state.PopulationThreshold) ~= nil and tonumber(state.PopulationThreshold) >= 1))
        and (state.WebhookEnabled == nil or type(state.WebhookEnabled) == "boolean")
        and (state.WebhookUrl == nil
            or (type(state.WebhookUrl) == "string" and #state.WebhookUrl <= 512))
end

local function loadAutoHopState()
    local runtimeState = rawget(getExecutorEnv(), "__ForestDonationsAutoHop")
    if isValidAutoHopState(runtimeState) then
        return {
            Enabled = runtimeState.Enabled,
            MinPlayers = tonumber(runtimeState.MinPlayers),
            MaxPlayers = tonumber(runtimeState.MaxPlayers),
            IntervalMinutes = tonumber(runtimeState.IntervalMinutes),
            PopulationEnabled = runtimeState.PopulationEnabled == true,
            PopulationThreshold = tonumber(runtimeState.PopulationThreshold) or 10,
            WebhookEnabled = runtimeState.WebhookEnabled == true,
            WebhookUrl = type(runtimeState.WebhookUrl) == "string" and runtimeState.WebhookUrl or "",
        }
    end

    local readFile = getExecutorFunction("readfile")
    if readFile then
        local readOk, contents = pcall(readFile, AUTO_HOP_SETTINGS_FILE)
        if readOk and type(contents) == "string" then
            local decodeOk, state = pcall(function()
                return HttpService:JSONDecode(contents)
            end)
            if decodeOk and isValidAutoHopState(state) then
                return {
                    Enabled = state.Enabled,
                    MinPlayers = tonumber(state.MinPlayers),
                    MaxPlayers = tonumber(state.MaxPlayers),
                    IntervalMinutes = tonumber(state.IntervalMinutes),
                    PopulationEnabled = state.PopulationEnabled == true,
                    PopulationThreshold = tonumber(state.PopulationThreshold) or 10,
                    WebhookEnabled = state.WebhookEnabled == true,
                    WebhookUrl = type(state.WebhookUrl) == "string" and state.WebhookUrl or "",
                }
            elseif decodeOk then
                warn("[Forest Donations] Saved auto-hop settings are invalid; using runtime settings.")
            else
                warn("[Forest Donations] Could not decode saved auto-hop settings: " .. tostring(state))
            end
        end
    end
    return nil
end

local function saveAutoHopState(state)
    local env = getExecutorEnv()
    rawset(env, "__ForestDonationsAutoHop", state)
    local writeFile = getExecutorFunction("writefile")
    if not writeFile then
        return false, "writefile is not available; settings only persist for this executor session."
    end

    local encodeOk, contents = pcall(function()
        return HttpService:JSONEncode(state)
    end)
    if not encodeOk then
        return false, "Could not encode auto-hop settings: " .. tostring(contents)
    end

    local writeOk, writeResult = pcall(writeFile, AUTO_HOP_SETTINGS_FILE, contents)
    if not writeOk or writeResult == false then
        return false, "Could not save " .. AUTO_HOP_SETTINGS_FILE .. ": " .. tostring(writeResult)
    end
    return true
end

local function getHttpRequest()
    local env = getExecutorEnv()
    local synApi = rawget(env, "syn")
    if synApi and synApi.request then return synApi.request end
    local httpApi = rawget(env, "http")
    if httpApi and httpApi.request then return httpApi.request end
    if env.http_request then return env.http_request end
    if env.request then return env.request end
    return nil
end

local function isValidDiscordWebhookUrl(url)
    return type(url) == "string"
        and #url <= 512
        and string.match(url, "^https://discord(app)?%.com/api/webhooks/%d+/[%w_-]+/?$") ~= nil
end

local function sendHopWebhook(target)
    local settings = loadAutoHopState()
    if not settings or settings.WebhookEnabled ~= true then
        return true
    end

    local webhookUrl = settings.WebhookUrl
    if not isValidDiscordWebhookUrl(webhookUrl) then
        return false, "Webhook is enabled, but its URL is invalid. Update it in the Webhook tab."
    end

    local payloadOk, payload = pcall(function()
        return HttpService:JSONEncode({
            content = ("Forest Donations: server hop initiated. Destination has %d/%d players.")
                :format(tonumber(target.playing) or 0, tonumber(target.maxPlayers) or 0),
            allowed_mentions = {parse = {}},
        })
    end)
    if not payloadOk then
        return false, "Could not encode the Discord webhook message: " .. tostring(payload)
    end

    local request = getHttpRequest()
    if request then
        local ok, response = pcall(request, {
            Url = webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload,
            Timeout = 8,
        })
        if not ok then
            return false, "Discord webhook request failed; verify the URL and HTTP request access."
        end
        if type(response) ~= "table" then
            return false, "Discord webhook returned no valid HTTP response."
        end
        local statusCode = tonumber(response.StatusCode or response.Status)
        if not statusCode then
            return false, "Discord webhook response did not include an HTTP status."
        end
        if statusCode < 200 or statusCode >= 300 then
            return false, ("Discord webhook returned HTTP %d."):format(statusCode)
        end
        return true, "Discord hop notification sent."
    end

    local ok, response = pcall(function()
        return HttpService:RequestAsync({
            Url = webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload,
        })
    end)
    if not ok then
        return false, "Discord webhook request failed; verify the URL and HTTP request access."
    end
    local statusCode = type(response) == "table" and tonumber(response.StatusCode) or nil
    if not statusCode then
        return false, "Discord webhook response did not include an HTTP status."
    end
    if statusCode < 200 or statusCode >= 300 then
        return false, ("Discord webhook returned HTTP %d."):format(statusCode)
    end
    return true, "Discord hop notification sent."
end

local function requestServerPage(url)
    local httpRequest = getHttpRequest()
    if httpRequest then
        for attempt = 1, 4 do
            local ok, response = pcall(httpRequest, {
                Url = url,
                Method = "GET",
                Headers = {["User-Agent"] = "Roblox"},
            })
            if not ok then
                return nil, "The HTTP request failed: " .. tostring(response)
            end
            if not response then
                return nil, "The HTTP request returned no response."
            end

            local statusCode = tonumber(response.StatusCode or response.Status)
            if statusCode == 429 then
                if attempt == 4 then
                    return nil, "Server list request remained rate-limited (HTTP 429) after 4 attempts."
                end
                local headers = response.Headers or response.headers
                local retryAfter
                if type(headers) == "table" then
                    for name, value in pairs(headers) do
                        if string.lower(tostring(name)) == "retry-after" then
                            retryAfter = tonumber(value)
                            break
                        end
                    end
                end
                task.wait(math.min(math.max(retryAfter or (2 ^ (attempt - 1)), 1), 30))
            elseif statusCode and (statusCode < 200 or statusCode >= 300) then
                return nil, ("Server list request failed with HTTP %d."):format(statusCode)
            else
                return response.Body or response.body or response.responseBody or response.text
            end
        end
        return nil, "Server list request failed after retries."
    end

    local getAsyncError
    for attempt = 1, 4 do
        local ok, body = pcall(function()
            return HttpService:GetAsync(url)
        end)
        if ok then
            return body
        end
        getAsyncError = body
        if not string.find(tostring(body), "429", 1, true) then
            break
        end
        if attempt < 4 then
            task.wait(2 ^ (attempt - 1))
        end
    end

    if string.find(tostring(getAsyncError), "429", 1, true) then
        return nil, "Server list request remained rate-limited (HTTP 429) after 4 attempts."
    end

    local httpGetOk, httpGetBody = pcall(function()
        return game:HttpGet(url)
    end)
    if httpGetOk then
        return httpGetBody
    end
    return nil, "Could not request the public server list: "
        .. tostring(getAsyncError) .. "; fallback failed: " .. tostring(httpGetBody)
end

local queueAutoHopUiReload
local setAutoHopState
local setPopulationHopState
local setWebhookSettings
