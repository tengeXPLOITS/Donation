queueAutoHopUiReload = function(enabled, minPlayers, maxPlayers, intervalMinutes)
    local queueCode = buildAutoHopQueueCode(enabled, minPlayers, maxPlayers, intervalMinutes)
    local queueFunctions = getQueueOnTeleport()
    local queueErrors = {}

    for _, queue in ipairs(queueFunctions) do
        local ok, result = pcall(queue, queueCode)
        if ok and result ~= false then
            return true
        end
        table.insert(queueErrors, tostring(result))
    end

    local writeFile = getExecutorFunction("writefile")
    if writeFile then
        local fileOk, fileError = pcall(writeFile, "forestdonos_queued.lua", queueCode)
        if fileOk then
            local fallbackCode = "dofile('forestdonos_queued.lua')"
            for _, queue in ipairs(queueFunctions) do
                local queueOk, result = pcall(queue, fallbackCode)
                if queueOk and result ~= false then
                    return true
                end
                table.insert(queueErrors, tostring(result))
            end
        else
            table.insert(queueErrors, "writefile failed: " .. tostring(fileError))
        end
    end

    if #queueFunctions == 0 then
        return false, "queue_on_teleport is not available."
    end
    return false, "Could not queue the UI reload: " .. table.concat(queueErrors, "; ")
end

local function startAutoHopWorker(minPlayers, maxPlayers, intervalMinutes)
    autoHopEnabled = true
    autoHopGeneration = autoHopGeneration + 1
    local generation = autoHopGeneration
    local intervalSeconds = intervalMinutes * 60

    autoHopButton.Text = "Auto Hop: ON"
    autoHopButton.BackgroundColor3 = Color3.fromRGB(72, 120, 82)
    hopStatus.Text = ("Auto hop enabled: every %d min, targeting %d-%d players.")
        :format(intervalMinutes, minPlayers, maxPlayers)

    task.spawn(function()
        while autoHopEnabled and generation == autoHopGeneration do
            for remaining = intervalSeconds, 1, -1 do
                if not autoHopEnabled or generation ~= autoHopGeneration then
                    return
                end
                if remaining % 60 == 0 then
                    hopStatus.Text = ("Auto hop in %d min; target %d-%d players.")
                        :format(remaining / 60, minPlayers, maxPlayers)
                end
                task.wait(1)
            end
            if autoHopEnabled and generation == autoHopGeneration then
                while hopping and autoHopEnabled and generation == autoHopGeneration do
                    task.wait(0.2)
                end
                if not autoHopEnabled or generation ~= autoHopGeneration then
                    return
                end
                hopping = true
                hopSearchCancelled = false
                hopButton.Active = false
                hopButton.Text = "Searching..."
                hopStatus.Text = "Auto-hop timer elapsed; searching for a matching server..."
                local ok, joined, message = pcall(
                    serverHop,
                    minPlayers,
                    maxPlayers,
                    function(searchMessage)
                        hopStatus.Text = searchMessage
                    end,
                    function()
                        return autoHopEnabled and generation == autoHopGeneration
                    end
                )
                if not ok then
                    local hopError = joined
                    joined = false
                    message = "Unexpected auto-hop error: " .. tostring(hopError)
                end
                hopStatus.Text = tostring(message)
                notify(message)
                if not joined then
                    warn("[Forest Donations] " .. tostring(message))
                    hopping = false
                    hopSearchCancelled = false
                    hopButton.Active = true
                    hopButton.Text = "Find & Join"
                else
                    print("[Forest Donations] " .. tostring(message))
                    return
                end
            end
        end
    end)
end

local function startPopulationHopWorker()
    populationHopGeneration = populationHopGeneration + 1
    local generation = populationHopGeneration
    task.spawn(function()
        while populationHopEnabled and generation == populationHopGeneration do
            local playerCount = #Players:GetPlayers()
            local threshold = tonumber(populationThresholdBox.Text)
            populationHopStatus.Text = ("Current server: %d players. Hop threshold: below %s.")
                :format(playerCount, threshold and tostring(threshold) or "invalid")

            if threshold and playerCount < threshold and not hopping then
                local minPlayers = tonumber(minPlayersBox.Text)
                local maxPlayers = tonumber(maxPlayersBox.Text)
                if not minPlayers or not maxPlayers
                    or minPlayers < 0 or maxPlayers < minPlayers
                    or minPlayers % 1 ~= 0 or maxPlayers % 1 ~= 0 then
                    populationHopStatus.Text = ("Current server has %d players, below %d. Set a valid Server Hop Min/Max range.")
                        :format(playerCount, threshold)
                else
                    hopping = true
                    hopSearchCancelled = false
                    hopButton.Active = false
                    hopButton.Text = "Searching..."
                    populationHopStatus.Text = ("Only %d players remain; searching for a destination in the configured range...")
                        :format(playerCount)
                    local savedState = loadAutoHopState()
                    local settingsSaved, settingsError = setAutoHopState(
                        savedState and savedState.Enabled == true or false,
                        minPlayers,
                        maxPlayers,
                        savedState and savedState.IntervalMinutes or tonumber(autoIntervalBox.Text) or 30
                    )
                    local ok, joined, message = pcall(
                        serverHop,
                        minPlayers,
                        maxPlayers,
                        function(searchMessage)
                            populationHopStatus.Text = searchMessage
                        end,
                        function()
                            return populationHopEnabled and generation == populationHopGeneration
                        end
                    )
                    if not ok then
                        message = "Unexpected population-hop error: " .. tostring(joined)
                        joined = false
                    end
                    if not settingsSaved then
                        message = tostring(message) .. " Settings were not saved: " .. tostring(settingsError)
                    end
                    populationHopStatus.Text = tostring(message)
                    notify(message)
                    if joined then
                        print("[Forest Donations] " .. tostring(message))
                        return
                    end
                    warn("[Forest Donations] " .. tostring(message))
                    hopping = false
                    hopSearchCancelled = false
                    hopButton.Active = true
                    hopButton.Text = "Find & Join"
                    task.wait(30)
                end
            end

            task.wait(5)
        end
    end)
end

